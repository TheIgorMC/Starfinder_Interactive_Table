DB_PASSWORD=change-me
# Signs login session cookies. Set this to a long random string in real use —
# generate one with: openssl rand -hex 32
# If left unset, the backend generates a random one at boot, which means
# everyone gets logged out on every container restart/redeploy.
SESSION_SECRET=change-me-too

# Local Ollama endpoint used by the Campaign tab's "AI draft" assistant
# (POST /api/campaign/ai-draft) — same OpenAI-compatible /v1 route as
# scripts/audit-normalized.js already uses. The backend runs in a container
# on the Pi, so this can't be localhost (that would mean the container
# itself, which has no Ollama running) — "fisso" is the LAN hostname of the
# desktop/GPU box that actually runs Ollama (the split-host setup in
# Docs/11-AI-integration.md), reachable by name from both the Pi and local
# dev on the same network.
OLLAMA_URL=http://fisso:11434/v1
OLLAMA_MODEL=qwen3:8b

# Shared secret the mcp-server container presents to the backend (header
# X-Service-Token) to act as the GM without a browser login — see
# backend/src/auth.js and mcp-server/README.md. Generate with:
# openssl rand -hex 32
# Leave unset to disable the MCP server's access to the backend entirely.
MCP_SERVICE_TOKEN=change-me-too

# Public URL the mcp-server container is reachable at (used for OAuth
# issuer/redirect URLs and metadata) — e.g. https://sit-mcp.example.com.
# Must be the exact origin your reverse proxy terminates TLS for.
MCP_PUBLIC_URL=https://sit-mcp.example.com

# Signs the mcp-server's own GM-login cookie (separate from the backend's
# SESSION_SECRET — different process, different cookie). Generate with:
# openssl rand -hex 32
MCP_SESSION_SECRET=change-me-too
